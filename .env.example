# ─── OpsPilot V2 Root Environment Configuration ──────────────────────────────
# Application Ports
PORT=3001
AI_PORT=8000
WEB_PORT=5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/opspilot

# JWT Authentication
JWT_SECRET=dev-jwt-super-secret-key-replace-in-prod
JWT_EXPIRES_IN=7d

# AI Service & Groq LLM
AI_SERVICE_URL=http://localhost:8000
INTERNAL_API_KEY=dev-internal-secret-key
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Frontend
VITE_API_URL=http://localhost:3001/api
CORS_ORIGIN=http://localhost:5173
