# OpsPilot AI Service Configuration
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Internal Service Auth (optional token shared between NestJS and FastAPI)
INTERNAL_API_KEY=dev-internal-secret-key

# AI Provider Selection: 'gemini' or 'groq'
AI_PROVIDER=gemini

# Google Gemini Configuration (Google AI Studio Free Tier)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TEMPERATURE=0.1

GEMINI_MAX_TOKENS=4096
GEMINI_TIMEOUT=30.0
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_DELAY=1.0
GEMINI_THINKING_BUDGET=0

# Groq LLM Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=4096
GROQ_TIMEOUT=30.0
GROQ_MAX_RETRIES=2

# CORS
CORS_ORIGIN=http://localhost:3001

